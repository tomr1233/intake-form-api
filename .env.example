# Server Configuration
PORT=8080
FRONTEND_URL=http://localhost:3000
GIN_MODE=debug

# Database Configuration
DATABASE_URL=postgres://expresnext:expresnext@localhost:5432/expresnext_intake?sslmode=disable

# Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key-here

# Webhook Configuration
# Required for /api/webhooks management endpoints. If unset, those routes
# return 503. Use a long random string in production.
ADMIN_API_KEY=

# Set to "true" for local development to allow webhooks to target
# 127.0.0.1 / private networks. Leave unset in production.
WEBHOOK_ALLOW_PRIVATE_IPS=
# Langfuse Tracing (optional — leave blank to disable)
# Get keys from Langfuse UI → Settings → API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# US: https://us.cloud.langfuse.com, EU: https://cloud.langfuse.com, or self-hosted URL
LANGFUSE_HOST=https://us.cloud.langfuse.com
