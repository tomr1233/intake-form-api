# Server Configuration
PORT=8080
FRONTEND_URL=http://localhost:3000
GIN_MODE=debug

# Database Configuration
DATABASE_URL=postgres://expresnext:expresnext@localhost:5432/expresnext_intake?sslmode=disable

# Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key-here

# Langfuse Tracing (optional — leave blank to disable)
# Get keys from Langfuse UI → Settings → API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# US: https://us.cloud.langfuse.com, EU: https://cloud.langfuse.com, or self-hosted URL
LANGFUSE_HOST=https://us.cloud.langfuse.com
